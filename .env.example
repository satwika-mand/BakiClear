# ---- Gemini (Person 2 / AI) ----
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Stable options: gemini-3.5-flash | gemini-3.8-flash | gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if GEMINI_MODEL is overloaded/unavailable (observed live
# during dev: gemini-3.5-flash 503'd while flash-lite stayed up)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- Context source ----
# mock = run entirely offline from data/*.json
# api  = call the FastAPI backend (recommended for the Streamlit app)
CONTEXT_SOURCE=api
BACKEND_BASE_URL=http://localhost:8000

# ---- Sarvam voice (Phase 7, optional) ----
SARVAM_API_KEY=

# ---- Backend / Person 1 ----
# Keep production credentials only in .env (which is gitignored).
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/database?sslmode=require

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Razorpay Configuration (optional / mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_USE_MOCK=true

# Environment
ENVIRONMENT=development
